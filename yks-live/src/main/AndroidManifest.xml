<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- İyi ki YKS içindeki canlı ekran paylaşımı: web'deki "Ekranımı paylaş" düğmesi
             ykslive://join?room=…&share=1 bağlantısıyla bu ekranı açar. Başlatıcıda ayrı simge yoktur. -->
        <activity
            android:name="com.ardaaxee.ykslive.LiveActivity"
            android:exported="true"
            android:label="Birlikte Canlı"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ykslive" android:host="join" />
            </intent-filter>
        </activity>
        <service
            android:name="com.ardaaxee.ykslive.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>
</manifest>
