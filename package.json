{
  "name": "arda-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARDA ROOM — an interactive first-person 3D personal digital space",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "dev:all": "concurrently -n client,server -c cyan,magenta \"npm:dev\" \"npm:server\""
  },
  "dependencies": {
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.16.0",
    "@react-three/postprocessing": "^2.16.2",
    "framer-motion": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.163.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.163.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "ws": "^8.18.0"
  }
}
