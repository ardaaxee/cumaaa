# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` .gitignore'dadır — asla depoya gönderilmez.

# ZORUNLU — Meta uygulamanızdan alınan uzun ömürlü kullanıcı token'ı.
# Gerekli izinler: instagram_basic, instagram_manage_insights,
#                  pages_show_list, pages_read_engagement
IG_ACCESS_TOKEN=

# OPSİYONEL — biliniyorsa keşif isteklerini atlar (daha hızlı, daha az kota).
# `python -m growth_os connect` komutu bu değeri ekrana yazar.
IG_USER_ID=
FB_PAGE_ID=

# OPSİYONEL — davranışsal ayarlar
IG_API_VERSION=v21.0
IG_HTTP_TIMEOUT=30
IG_MAX_RETRIES=4
