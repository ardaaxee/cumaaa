# ARDA ROOM / CUMA HOME — environment configuration.
# Copy to `.env.local` and fill in. NEVER put a secret in any VITE_* variable:
# everything prefixed VITE_ is compiled into the browser bundle and is public.

# Auth backend base URL. Leave EMPTY to run the local demo provider, which
# stores no password and does not offer Google sign-in.
# When set, the app expects:
#   POST /auth/register  POST /auth/login  POST /auth/guest
#   POST /auth/logout    GET  /auth/session  PATCH /auth/profile
#   GET  /auth/google/start  (backend performs the OAuth code exchange)
VITE_AUTH_PROVIDER_URL=

# Google OAuth *client id* only — this is a public identifier.
# The client SECRET belongs on the auth backend and must never appear here.
VITE_GOOGLE_CLIENT_ID=

# Co-op WebSocket server. Defaults to ws://<page-host>:8787 when unset.
VITE_MULTIPLAYER_URL=

# Optional AI proxy for the in-world assistant. The model API key lives on the
# proxy, not in this file.
VITE_AI_PROXY_URL=

# Optional label shown in the AI panel when a proxy is configured.
VITE_AI_MODEL_LABEL=CUMA-AI
