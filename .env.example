# ARDA ROOM — environment configuration example
#
# Copy this file to `.env` and fill in values. NEVER commit a real `.env`.
# The AI panel works fully offline with a built-in fallback engine, so these
# values are optional. If you later add a backend proxy for a real LLM,
# point the frontend at it here. The frontend must NEVER embed a raw API key —
# route requests through your own backend instead.

# URL of YOUR backend proxy that talks to the AI provider.
# The browser only ever calls this URL, never the provider directly.
VITE_AI_PROXY_URL=

# Optional label shown in the AI panel when a proxy is configured.
VITE_AI_MODEL_LABEL=CUMA-AI
