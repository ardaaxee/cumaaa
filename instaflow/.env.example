# InstaFlow yapılandırması
#
# Bu dosyayı `.env` olarak kopyalayın ve kendi değerlerinizi girin:
#   cp .env.example .env
#
# UYARI: `.env` dosyası .gitignore içindedir ve asla depoya eklenmemelidir.
# Buradaki değerlerin hiçbiri gerçek bir anahtar değildir.

# ---------------------------------------------------------------- uygulama
APP_ENV=production

# Üretimde kapalı kalmalı. Açıkken /docs ve /openapi.json erişilebilir olur
# ve loglar ayrıntılanır.
DEBUG=false

# GÜVENLİK: 127.0.0.1 olarak bırakın. Panelde giriş ekranı YOKTUR; 0.0.0.0
# yaparsanız aynı ağdaki herkes içeriklerinizi görüntüleyip yayınlayabilir.
# Dışarıdan erişim gerekiyorsa kimlik doğrulamalı bir ters vekil kullanın.
HOST=127.0.0.1
PORT=8000

# Planlama ve gösterimde kullanılan yerel saat dilimi.
TIMEZONE=Europe/Istanbul

# Oturum çerezini ve CSRF token'larını imzalar. Boş bırakılırsa her açılışta
# yeni bir anahtar üretilir ve açık oturumlar geçersiz olur.
# Üretimde MUTLAKA doldurun; değerinizi şu komutla üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# ---------------------------------------------------------------- instagram
# Giriş kipi:
#   instagram = Instagram Login ile Instagram API (graph.instagram.com)
#               Facebook sayfası gerekmez.
#   facebook  = Facebook Login ile Instagram API (graph.facebook.com)
#               Instagram hesabı bir Facebook sayfasına bağlı olmalıdır.
INSTAGRAM_LOGIN_MODE=instagram

# Meta Graph API sürümü. Ağustos 2026 itibarıyla en yeni sürüm v26.0'dır;
# varsayılan olarak daha oturmuş bir sürüm kullanılır. Meta sürümleri ~2 yıl
# sonra kapattığı için bu değeri zaman zaman güncellemeniz gerekir.
INSTAGRAM_API_VERSION=v25.0

# Uzun ömürlü erişim token'ı ve Instagram Professional hesap kimliği.
# Panelden OAuth ile bağlanırsanız bunları elle girmenize gerek yoktur.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Meta uygulama kimlik bilgileri (OAuth akışı için gerekli).
META_APP_ID=
META_APP_SECRET=

# Meta uygulamasında "Valid OAuth Redirect URI" olarak kayıtlı olmalıdır.
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# ÖNEMLİ: Instagram medyayı yalnızca herkese açık bir URL'den indirir;
# uygulamadan doğrudan dosya yüklenemez. Yerel dosyaları yayınlayabilmek için
# uygulamanın internetten erişilebilir adresini buraya yazın (örn. bir tünel
# adresi). Boş bırakırsanız içeriklere elle bir medya adresi girmeniz gerekir.
#
# Tanımlarsanız /media/<alt-dizin>/<dosya> ucu dışarıdan erişilebilir olur.
# Bu uç yalnızca content/ altındaki drafts, scheduled, published ve failed
# dizinlerinden, yalnızca izin verilen medya uzantılarını servis eder.
PUBLIC_BASE_URL=

# ------------------------------------------------------------------- AI
# openai | anthropic | local | none
# AI tamamen isteğe bağlıdır. Anahtar yoksa ya da sağlayıcı hata verirse
# sistem kural tabanlı yerel üreticiye düşer; uygulama çökmez.
AI_PROVIDER=local

# Kendi anahtarınızı girin. Aşağıdakiler yalnızca değişken adlarıdır;
# hiçbiri gerçek bir anahtar değildir.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI uyumlu yerel bir sunucu kullanıyorsanız bu adresi değiştirin.
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ------------------------------------------------------------- zamanlama
# Scheduler kaç saniyede bir zamanı gelen gönderileri kontrol etsin.
SCHEDULER_INTERVAL_SECONDS=60
# Başarısız bir yayın kaç kez denensin.
PUBLISH_MAX_ATTEMPTS=3
# 24 saatte izin verilen azami yayın (Meta'nın kotası 50'dir).
DAILY_PUBLISH_GUARD=25
# Süreç yayın ortasında ölürse içerik 'publishing' durumunda kalır. Kilidi bu
# kadar dakikadan eski olan içerikler yeniden denenebilir duruma çekilir.
STALE_LOCK_MINUTES=30
# İstatistik ve token kontrolü işlerinin UTC saati.
ANALYTICS_SYNC_HOUR=3
TOKEN_CHECK_HOUR=4

# ---------------------------------------------------------------- medya
MAX_IMAGE_MB=8
MAX_VIDEO_MB=100
# Meta'nın görsel yayın belgeleri JPEG ister.
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov

# ------------------------------------------------------------- istatistik
# Meta 21 Nisan 2025'ten itibaren impressions, plays ve video_views
# metriklerini kaldırdı; yerlerine `views` geldi. Metrik setleri değişmeye
# devam ettiği için liste buradan yönetilir.
MEDIA_INSIGHT_METRICS=reach,likes,comments,saved,shares,views,total_interactions
ACCOUNT_INSIGHT_METRICS=reach,follower_count,views

# --------------------------------------------------------------------- HTTP
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
