{
  "name": "iyi-ki-yks",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "İyi ki • YKS Çalışma Odası — TYT + AYT sayısal hazırlık uygulaması",
  "scripts": {
    "dev": "vite",
    "generate:question-meta": "node scripts/generate-question-metadata.mjs",
    "build": "node scripts/generate-question-metadata.mjs && tsc -b && vite build && node scripts/check-build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "node scripts/generate-question-metadata.mjs && tsc -b --noEmit",
    "test": "node scripts/generate-question-metadata.mjs && vitest run",
    "test:watch": "vitest",
    "coverage": "node scripts/generate-question-metadata.mjs && vitest run --coverage",
    "e2e": "node scripts/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
