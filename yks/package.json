{
  "name": "iyi-ki-yks",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "İyi ki • YKS Çalışma Odası — TYT + AYT sayısal hazırlık uygulaması",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:content && tsc -b && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "release:check": "npm test && npm run build && node scripts/check-release.mjs && npm run audit:content",
    "gen:content": "node --experimental-strip-types --no-warnings scripts/gen-content-index.mjs",
    "pretest": "npm run gen:content && npm run test:study",
    "e2e": "node scripts/e2e.mjs",
    "audit:content": "node --experimental-strip-types --no-warnings scripts/audit-content.mjs",
    "test:study": "node --experimental-strip-types tests/studyTools.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
